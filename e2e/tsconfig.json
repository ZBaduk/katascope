{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts",
    "support/**/*.ts",
    "support/**/*.d.ts"
  ]
}
