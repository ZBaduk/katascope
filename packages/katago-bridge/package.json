{
  "name": "@katascope/katago-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Node-side adapters: KataGo analysis engine and the Python activation sidecar.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --exclude '**/*.katago.spec.ts'",
    "test:katago": "vitest run katago.spec"
  },
  "dependencies": {
    "@katascope/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
