{
  "name": "katascope",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for inspecting the internals of KataGo neural networks",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "packages/core",
    "packages/katago-bridge",
    "packages/ui",
    "apps/desktop",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dump": "npm run build:libs --silent && node packages/katago-bridge/dist/cli/dump.js",
    "build": "npm run build --workspace @katascope/core --workspace @katascope/katago-bridge && npm run build --workspace @katascope/ui && npm run build --workspace katascope-desktop",
    "build:libs": "npm run build --workspace @katascope/core --workspace @katascope/katago-bridge",
    "pretypecheck": "npm run build:libs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:libs",
    "test": "npm run test --workspaces --if-present",
    "pretest:ci": "npm run build:libs",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "test:e2e": "npm run build && npm run e2e --workspace katascope-e2e",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo apps/*/dist packages/ui/.angular",
    "prepare": "npm run build:libs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.0",
    "electron": "^44.3.0",
    "typescript": "6.0.3"
  }
}
